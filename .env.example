# Banco de Dados (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alaska_rag_db

# Redis (BullMQ para filas e workers assíncronos)
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama Local (Inferência e Embeddings)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3
