{
  "name": "alaska-rag-lab",
  "version": "1.0.0",
  "description": "Laboratório prático de arquitetura RAG Bare Metal com NestJS, pgvector, Ollama e Zod",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "worker": "tsx src/scripts/run-worker.ts",
    "ingest": "tsx src/scripts/ingest-file.ts",
    "search": "tsx src/scripts/test-search.ts",
    "ask": "tsx src/scripts/ask.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "rag",
    "pgvector",
    "bullmq",
    "ollama",
    "nestjs",
    "zod"
  ],
  "author": "Alaska Websites",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
